<?php

$orders =
[
    "serve",
    "controller",
    "model",
    "astra:migration",
    "astra:migrate",
    "routes"
];

if(count($argv) < 2)
{
    echo "Please indicate an order";
    die();
}

if(!in_array($argv[1], $orders))
{
    echo "Order unknown";
    die();
}

if($argv[1] === "serve")
{
    $port = $argv[2] ?? 8000;
    $public = $argv[3] ?? "public";
    exec("php -S localhost:$port -t $public");
}

else
if($argv[1] === "controller")
{
    $controller = $argv[2] ?? "";

    if($controller === "")
    {
        echo "Enter name of controller (Ex: HomeController) : ";
        fscanf(STDIN, "%s", $controller);
    }

    if($controller === "")
    {
        echo "Enter name of controller (Ex: HomeController) : ";
        fscanf(STDIN, "%s", $controller);
    }

    while(1)
    {
        $pattern = '/^[A-Z][a-zA-Z0-9]*Controller$/';
        if(!preg_match($pattern, $controller))
        {
            echo "Please enter a name with good format : ";
            fscanf(STDIN, "%s", $controller);
        }

        else
        {
            break;
        }
    }

    sscanf($controller, "%sController", $root);
    $root = substr($controller, 0, strpos($controller, "Controller"));

    $contentFile = "<?php

namespace App\Controllers;

use Src\Controllers\AbstractController;

class $controller extends AbstractController
{
    public function index()
    {
        //

        \$this->render('$root/index.prism.php', ['controller' => '$controller']);
    }
}";

    file_put_contents(__DIR__ . "/app/Controllers/$controller.php", $contentFile);

    mkdir(__DIR__ . "/app/View/$root");

    $contentFile = "<!DOCTYPE html>
<html>
    <head>
        <meta charset=\"UTF-8\">
        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">
        <title>Hello {{ \$controller }}</title>
    </head>
    <body>
        <div>
            <h1>Hello {{ \$controller }}</h1>
            <p>Add routes in \"app/Routes/web.php\"</p>
        </div>
    </body>
</html>";

    file_put_contents(__DIR__ . "/app/View/$root/index.prism.php", $contentFile);

    echo "$controller created !";
}

else
if($argv[1] === "model")
{
    $model = $argv[2] ?? "";

    if($model === "")
    {
        echo "Enter name of model (Ex: Home) : ";
        fscanf(STDIN, "%s", $model);
    }

    $properties = [];

    while(1)
    {
        $propertie = ["name" => ""];
    
        echo "Entrer a new property (Enter to quit) : ";
        fscanf(STDIN, "%s", $propertie["name"]);

        if($propertie["name"] === "")
        {
            break;
        }

        echo "Type of your property (int, string, text, relation, json, date, datetime) : ";
        fscanf(STDIN, "%s", $propertie["type"]);
        echo "\n";

        if($propertie["type"] === "relation")
        {
            echo "What model related : ";
            fscanf(STDIN, "%s", $propertie["relation"]);

            while(1)
            {
                echo "Type of relation (OneToOne, ManyToOne, OneToMany, ManyToMany) : ";

                $relations = ["OneToOne", "ManyToOne", "OneToMany", "ManyToMany"];

                $type = "";
                fscanf(STDIN, "%s", $type);

                if(!in_array($type, $relations))
                {
                    echo "Unknown relation";
                }

                else
                {
                    $propertie["relation"] = $type;
                    break;
                }
            }

            echo "\n";
        }

        array_push($properties, $propertie);
    }

    $contentFile = "<?php

namespace App\Models;

class $model
{
	/** @var int @Column(type=\"int\", primary_key=true, name=\"id\") */
    private int \$id;

";

    foreach($properties as $p)
    {
        $name = $p["name"];
        $type = $p["type"];
        $snakeCase = strtolower(preg_replace('/(?<!^)[A-Z]/', '_$0', $name));
    
        if($type === "int")
        {
            $contentFile .= "\t/** @var int @Column(type=\"int\", name=\"$snakeCase\") */\n\tprivate string \$$name;\n\n";
        }
        
        else
        if($type === "string")
        {
            $contentFile .= "\t/** @var string @Column(type=\"string\", length=255, name=\"$snakeCase\") */\n\tprivate string \$$name;\n\n";
        }

        else
        if($type === "text")
        {
            $contentFile .= "\t/** @var string @Column(type=\"text\", name=\"$snakeCase\") */\n\tprivate string \$$name;\n\n";
        }

        else
        if($type === "date")
        {
            $contentFile .= "\t/** @var \DateTimeImmutable @Column(type=\"date\", name=\"$snakeCase\") */\n\tprivate \DateTimeImmutable \$$name;\n\n";
        }
    }

    $contentFile .= "\tpublic function getId(): int\n\t{\n\t\treturn \$this->id;\n\t}\n\n";

    foreach($properties as $p)
    {
        $nameProp = $p["name"];
        $nameFunc = "get" . ucfirst($p["name"]);
        $type = $p["type"];

        if($type === "text")
        {
            $type = "string";
        }

        else
        if($type === "date")
        {
            $type = "\DateTimeImmutable";
        }
    
        $contentFile .= "\tpublic function $nameFunc(): $type\n\t{\n\t\treturn \$this->$nameProp;\n\t}\n\n";
    }

    $index = 0;

    $contentFile .= "\tpublic function setId(int \$id): self\n\t{\n\t\t\$this->id = \$id;\n\t\treturn \$this;\n\t}\n\n";

    foreach($properties as $p)
    {
        $nameProp = $p["name"];
        $nameFunc = "set" . ucfirst($p["name"]);
        $type = $p["type"];

        if($type === "text")
        {
            $type = "string";
        }

        else
        if($type === "date")
        {
            $type = "\DateTimeImmutable";
        }
    
        $contentFile .= "\tpublic function $nameFunc($type \$$nameProp): self\n\t{\n\t\t\$this->$nameProp = \$$nameProp;\n\t\treturn \$this;\n\t}";

        if($index < count($properties) - 1)
        {
            $contentFile .= "\n\n";
        }

        $index++;
    }

    $contentFile .= "\n}";

    if(!is_dir(__DIR__ . "/app/Models"))
    {
        mkdir(__DIR__ . "/app/Models");
    }

    file_put_contents(__DIR__ . "/app/Models/$model.php", $contentFile);

    echo "\nModel $model created !";
}

else
if($argv[1] === "astra:migration")
{
    $elements = scandir(__DIR__ . "/app/Models");

    $paths = [];
    $models = [];

    foreach($elements as $el)
    {
        if(strpos($el, ".php"))
        {
            array_push($paths, __DIR__ . "/app/Models/" . $el);

            $model = substr($el, 0, strpos($el, ".php"));
            array_push($models, $model);
        }
    }

    $tables = [];

    for($i = 0 ; $i < count($paths) ; $i++)
    {
        $path = $paths[$i];
        $model = $models[$i];

        $table = ["name" => $model];
        $table["properties"] = [];

        $file = fopen($path, "r");

        while(1)
        {
            $line = fgets($file);
            if(!$line)
            {
                break;
            }

            if(strpos($line, "/** @var"))
            {
                $type = substr($line, strpos($line, "type=") + 6);
                $type = substr($type, 0, strpos($type, "\""));

                $name = substr($line, strpos($line, "name=") + 6);
                $name = substr($name, 0, strpos($name, "\""));

                $primaryKey = strpos($line, "primary_key=true");

                if($type === "string")
                {
                    $type = "varchar(255)";
                }

                array_push($table["properties"], ["name" => $name, "type" => $type, "primary_key" => $primaryKey !== false]);
            }
        }

        fclose($file);

        array_push($tables, $table);
    }

    $date = new DateTime();
    $date->setTimezone(new DateTimeZone("Europe/Paris"));

    $pathMigrations = __DIR__ . "/app/Migrations";

    if(!is_dir($pathMigrations))
    {
        mkdir($pathMigrations);
    }

    file_put_contents($pathMigrations . "/migration_" . $date->getTimestamp() . ".json", json_encode($tables, JSON_PRETTY_PRINT));
}

else
if($argv[1] === "astra:migrate")
{
    $content = file_get_contents(__DIR__ . "/.env");
    if($content === "" || !$content)
    {
        echo "Add variable DATABASE_URL in your .env file";
        die();
    }

    $url = "";

    $lines = explode("\n", $content);
    
    foreach($lines as $line)
    {
        [$key, $value] = explode("=", $line);
        
        if($key === "DATABASE_URL")
        {
            $url = $value;
            
            if(str_starts_with($url, "\""))
            {
                $url = substr($url, 1, strlen($url));
            }
                
            break;
        }
    }

    if($url === "")
    {
        echo "Add variable DATABASE_URL in your .env file";
        die();
    }

    $elements = scandir(__DIR__ . "/app/Migrations", SCANDIR_SORT_DESCENDING);

    if(!$elements)
    {
        die();
    }

    $migrations = [];
    foreach($elements as $el)
    {
        if(strpos($el, ".json") && count($migrations) < 2)
        {
            array_push($migrations, __DIR__ . "/app/Migrations/" . $el);
        }
    }

    $request = "";

    if(count($migrations) === 1)
    {
        $content = file_get_contents($migrations[0]);
        $tables = json_decode($content, true);

        foreach($tables as $table)
        {
            $name = lcfirst($table["name"]);
        
            $request .= "DROP TABLE IF EXISTS `$name`;\n";
            $request .= "CREATE TABLE IF NOT EXISTS `$name` (";

            foreach($table["properties"] as $property)
            {
                $name = $property["name"];
                $type = $property["type"];
                $primaryKey = $property["primary_key"];
            
                $request .= "`$name` $type NOT NULL";

                if($primaryKey)
                {
                    $request .= " AUTO_INCREMENT";
                }

                $request .= ", ";
            }

            $request .= "PRIMARY KEY (`id`));";
        }
    }

    else
    {
        //
    }

    $db = parse_url($url);

    $dsn = sprintf(
        "mysql:host=%s;port=%d;dbname=%s;charset=utf8mb4",
        $db['host'],
        $db['port'] ?? 3306,
        ltrim($db['path'], '/')
    );

    $pdo = new PDO($dsn, $db['user'], $db['pass'] ?? '', [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);

    if($pdo->exec($request))
    {
        echo "Migration ok !";
    }
}