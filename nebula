else
if($argv[1] === "model")
{
    $model = $argv[2] ?? "";

    if($model === "")
    {
        echo "Enter name of model (Ex: Home) : ";
        fscanf(STDIN, "%s", $model);
    }

    $properties = [];

    while(1)
    {
        $propertie = ["name" => ""];
    
        echo "Entrer a new property (Enter to quit) : ";
        fscanf(STDIN, "%s", $propertie["name"]);

        if($propertie["name"] === "")
        {
            break;
        }

        echo "Type of your property (int, string, text, relation, json, date, datetime) : ";
        fscanf(STDIN, "%s", $propertie["type"]);
        echo "\n";

        if($propertie["type"] === "relation")
        {
            echo "What model related : ";
            fscanf(STDIN, "%s", $propertie["relation"]);

            while(1)
            {
                echo "Type of relation (OneToOne, ManyToOne, OneToMany, ManyToMany) : ";

                $relations = ["OneToOne", "ManyToOne", "OneToMany", "ManyToMany"];

                $type = "";
                fscanf(STDIN, "%s", $type);

                if(!in_array($type, $relations))
                {
                    echo "Unknown relation";
                }

                else
                {
                    $propertie["relation"] = $type;
                    break;
                }
            }

            echo "\n";
        }

        array_push($properties, $propertie);
    }

    $contentFile = "<?php

namespace App\Models;

class $model
{
	/** @var int @Column(type=\"int\", primary_key=true, name=\"id\") */
    private int \$id;

";

    foreach($properties as $p)
    {
        $name = $p["name"];
        $type = $p["type"];
        $snakeCase = strtolower(preg_replace('/(?<!^)[A-Z]/', '_$0', $name));
    
        if($type === "int")
        {
            $contentFile .= "\t/** @var int @Column(type=\"int\", name=\"$snakeCase\") */\n\tprivate string \$$name;\n\n";
        }
        
        else
        if($type === "string")
        {
            $contentFile .= "\t/** @var string @Column(type=\"string\", length=255, name=\"$snakeCase\") */\n\tprivate string \$$name;\n\n";
        }

        else
        if($type === "text")
        {
            $contentFile .= "\t/** @var string @Column(type=\"text\", name=\"$snakeCase\") */\n\tprivate string \$$name;\n\n";
        }

        else
        if($type === "date")
        {
            $contentFile .= "\t/** @var \DateTimeImmutable @Column(type=\"date\", name=\"$snakeCase\") */\n\tprivate \DateTimeImmutable \$$name;\n\n";
        }
    }

    $contentFile .= "\tpublic function getId(): int\n\t{\n\t\treturn \$this->id;\n\t}\n\n";

    foreach($properties as $p)
    {
        $nameProp = $p["name"];
        $nameFunc = "get" . ucfirst($p["name"]);
        $type = $p["type"];

        if($type === "text")
        {
            $type = "string";
        }

        else
        if($type === "date")
        {
            $type = "\DateTimeImmutable";
        }
    
        $contentFile .= "\tpublic function $nameFunc(): $type\n\t{\n\t\treturn \$this->$nameProp;\n\t}\n\n";
    }

    $index = 0;

    $contentFile .= "\tpublic function setId(int \$id): self\n\t{\n\t\t\$this->id = \$id;\n\t\treturn \$this;\n\t}\n\n";

    foreach($properties as $p)
    {
        $nameProp = $p["name"];
        $nameFunc = "set" . ucfirst($p["name"]);
        $type = $p["type"];

        if($type === "text")
        {
            $type = "string";
        }

        else
        if($type === "date")
        {
            $type = "\DateTimeImmutable";
        }
    
        $contentFile .= "\tpublic function $nameFunc($type \$$nameProp): self\n\t{\n\t\t\$this->$nameProp = \$$nameProp;\n\t\treturn \$this;\n\t}";

        if($index < count($properties) - 1)
        {
            $contentFile .= "\n\n";
        }

        $index++;
    }

    $contentFile .= "\n}";

    if(!is_dir(__DIR__ . "/app/Models"))
    {
        mkdir(__DIR__ . "/app/Models");
    }

    file_put_contents(__DIR__ . "/app/Models/$model.php", $contentFile);

    echo "\nModel $model created !";
}

else
if($argv[1] === "astra:migration")
{
    //Get tables in DB
    $db = parse_url($datasEnv["DATABASE_URL"]);

    $dsn = sprintf(
        "mysql:host=%s;port=%d;dbname=%s;charset=utf8mb4",
        $db['host'],
        $db['port'] ?? 3306,
        ltrim($db['path'], '/')
    );

    $pdo = new PDO($dsn, $db['user'], $db['pass'] ?? '', [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);

    $th = $pdo->query("SHOW TABLES");
    $resTables = $th->fetchAll();

    $tables = [];
    foreach($resTables as $rTable)
    {
        $key = array_values($rTable)[0];

        $th = $pdo->query("SHOW COLUMNS FROM " . $key);
        $resCol = $th->fetchAll();

        $table = [];

        foreach($resCol as $rCol)
        {
            $col["name"] = $rCol["Field"];
            $col["type"] = $rCol["Type"];
            $col["primary_key"] = $rCol["Key"] === "PRI";

            array_push($table, $col);
        }
    
        $tables[$key] = $table;
    }

    ///////////////////////////////////

    //Get models in directory
    $models = [];

    $elements = scandir(__DIR__ . "/app/Models");

    if($elements)
    {
        foreach($elements as $el)
        {
            if(strpos($el, ".php"))
            {
                $content = file_get_contents(__DIR__ . "/app/Models/$el");
                $lines = explode("\n", $content);

                $key = lcfirst(substr($el, 0, strpos($el, ".php")));
                $model = [];

                foreach($lines as $line)
                {
                    if(strpos($line, "/**") && strpos($line, "@var") && strpos($line, "*/"))
                    {
                        $col["name"] = substr($line, strpos($line, "name=") + 6);
                        $col["name"] = substr($col["name"], 0, strpos($col["name"], "\""));
                        
                        $col["type"] = substr($line, strpos($line, "type=") + 6);
                        $col["type"] = substr($col["type"], 0, strpos($col["type"], "\""));

                        $col["primary_key"] = strpos($line, "primary_key=true") !== false;

                        array_push($model, $col);
                    }
                }

                $models[$key] = $model;
            }
        }
    }

    ///////////////////////////////////

    //Creating requests
    $requests = [];

    foreach($models as $key => $m)
    {
        //Table in DB doesn't exist
        if(!array_key_exists($key, $tables))
        {
            $sql = "CREATE TABLE `$key` (";

            foreach($m as $col)
            {
                $name = $col["name"];
                $type = $col["type"];

                if($type === "string")
                {
                    $type = "varchar(255)";
                }

                $primaryKey = $col["primary_key"];

                $sql .= "`$name` $type NOT NULL";

                if($primaryKey)
                {
                    $sql .= " AUTO_INCREMENT";
                }

                $sql .= ", ";
            }

            $sql .= "PRIMARY KEY (`id`))";
            array_push($requests, $sql);
        }

        else
        {
            $table = $tables[$key];
        
            foreach($m as $col)
            {
                $name = $col["name"];
                $type = $col["type"];
                $colExists = false;

                foreach($table as $col)
                {
                    if($col["name"] === $name)
                    {
                        $colExists = true;
                        break;
                    }
                }

                //Column to add in DB
                if(!$colExists)
                {
                    $sql = "ALTER TABLE `$key` ADD $name $type NOT NULL";
                    array_push($requests, $sql);
                }
            }
        }
    }

    //No requests
    if(!count($requests))
    {
        die();
    }

    //Creating directory
    $pathDir = __DIR__ . "/app/Migrations";
    if(!is_dir($pathDir))
    {
        mkdir($pathDir);
    }

    $content = "";

    foreach($requests as $req)
    {
        $content .= $req . ";\n";
    }

    //Current timestamp as file name
    $now = new DateTime();
    $now->setTimezone(new DateTimeZone("Europe/Paris"));
    $ts = $now->getTimestamp();
    
    $pathFile = "$pathDir/migration_$ts.sql";

    file_put_contents($pathFile, $content);

    echo "Migratiion created !";
}

else
if($argv[1] === "astra:migrate")
{
    $contentDir = scandir(__DIR__ . "/app/Migrations");
    if(!$contentDir)
    {
        die();
    }

    $request = "";

    foreach($contentDir as $el)
    {
        if(strpos($el, ".sql"))
        {
            $request = file_get_contents(__DIR__ . "/app/Migrations/" . $el);
            //Last migration only
        }
    }

    if($request !== "")
    {
        $db = parse_url($datasEnv["DATABASE_URL"]);

        $dsn = sprintf(
            "mysql:host=%s;port=%d;dbname=%s;charset=utf8mb4",
            $db['host'],
            $db['port'] ?? 3306,
            ltrim($db['path'], '/')
        );

        $pdo = new PDO($dsn, $db['user'], $db['pass'] ?? '', [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
        ]);

        $th = $pdo->exec($request);

        echo "Migration done !";
    }
}